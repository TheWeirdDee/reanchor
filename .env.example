# Copy to .env.local (git-ignored) and fill in. All variables are server-side only; none use the NEXT_PUBLIC_ prefix.

# Language model (optional). Without a key, the structured form and computed results still work;
# natural-language extraction and the case explanation show their fallback.
REANCHOR_MODEL_PROVIDER=gemini
REANCHOR_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Alternative provider (optional): any OpenAI-compatible endpoint.
# REANCHOR_MODEL_PROVIDER=openai-compatible
# REANCHOR_OPENAI_BASE_URL=
# REANCHOR_OPENAI_API_KEY=

# Set to 1 to disable every model call.
# REANCHOR_LLM_DISABLED=1

# Public https origin of the deployment (optional). Enables canonical links, the social image URL,
# sitemap entries and indexing. Ignored if it is not https or points at localhost. Set before building.
# REANCHOR_SITE_URL=https://your-deployment.example
